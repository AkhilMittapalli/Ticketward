# Ticketward - example environment. Copy to `.env` (gitignored) and adjust.
# PLACEHOLDERS ONLY: never put real secrets here. Passwords belong in secret files
# (./secrets/tw_*, created by `python scripts/gen_dev_secrets.py`).
#
# Who reads this file:
#   * docker compose: variable interpolation in compose*.yaml (TW_ENV, TW_IMAGE_TAG ...)
#   * local runs: `uv run --env-file ../.env ...` from backend/ (see Makefile `run`)
# Every setting in backend/src/ticketward/core/config.py is listed below with its default.

# ---------------------------------------------------------------- core
# dev | test | prod. Unset means prod (fails closed: prod refuses weak secrets,
# debug, docs, CORS and non-JSON logs).
TW_ENV=dev
# Logical service name (logs, Postgres application_name). Pattern ^[a-z][a-z0-9-]{2,63}$
TW_SERVICE_NAME=ticketward-api
# Framework debug pages. Dev only; refused in prod.
TW_DEBUG=false
# OpenAPI + Swagger UI at /api/docs. Empty = on unless prod; true is refused in prod.
TW_DOCS_ENABLED=
# DEBUG | INFO | WARNING | ERROR | CRITICAL
TW_LOG_LEVEL=INFO
# JSON logs (required in prod). false = human-readable console output.
TW_LOG_JSON=true
# Directory with secret files named tw_<setting> (Compose mounts /run/secrets).
# Relative paths resolve from the working directory (backend/ for Makefile targets).
TW_SECRETS_DIR=../secrets

# ---------------------------------------------------------------- database (Postgres 16 + pgvector)
# Either a full DSN (postgresql+asyncpg:// only) ...
# TW_DATABASE_URL=postgresql+asyncpg://ticketward:<password>@127.0.0.1:5432/ticketward
# ... or the parts below; the password comes from secrets/tw_db_password.
TW_DB_HOST=127.0.0.1
TW_DB_PORT=5432
TW_DB_NAME=ticketward
TW_DB_USER=ticketward
# TW_DB_PASSWORD=<placeholder: prefer the secret file>
TW_DB_POOL_SIZE=5
TW_DB_MAX_OVERFLOW=5
TW_DB_POOL_TIMEOUT_S=10
TW_DB_CONNECT_TIMEOUT_S=5
TW_DB_COMMAND_TIMEOUT_S=30

# ---------------------------------------------------------------- redis
# No credentials in the URL (rejected); the password comes from secrets/tw_redis_password.
TW_REDIS_URL=redis://127.0.0.1:6379/0
# TW_REDIS_PASSWORD=<placeholder: prefer the secret file>
TW_REDIS_SOCKET_TIMEOUT_S=2

# ---------------------------------------------------------------- http
# Browser origins allowed with credentials: comma-separated or JSON list. Dev only;
# must be empty in prod (UI and API are same-origin behind the reverse proxy).
# Interim dev only (placeholder UI via `pnpm dev`); removed in P8 when dev runs same-origin through Caddy.
TW_CORS_ORIGINS=http://localhost:3000
# Per-route body limits in bytes (spec §11, A-25(g)); oversized bodies get 413 problem+json.
# Each must stay <= 3000000 (the edge cap in the P9 Caddyfile sits just above the largest).
# Every route without its own limit:
TW_BODY_LIMIT_DEFAULT_BYTES=65536
# POST /api/v1/tickets (the binding per-ticket byte cap, 256 KB):
TW_BODY_LIMIT_TICKET_BYTES=262144
# POST /api/v1/tickets/batch (at most 50 tickets, 2 MB):
TW_BODY_LIMIT_TICKET_BATCH_BYTES=2097152
# POST /api/v1/kb/documents and POST /api/v1/kb/documents/{doc_key}/versions (1 MB):
TW_BODY_LIMIT_KB_DOCUMENT_BYTES=1048576
# Per-dependency timeout for GET /api/v1/health/ready.
TW_READY_CHECK_TIMEOUT_S=2

# ---------------------------------------------------------------- frontier model (P7, off by default)
TW_FRONTIER_ENABLED=false
TW_FRONTIER_DAILY_BUDGET_USD=2.00

# ---------------------------------------------------------------- compose-only variables
# Image tag for the locally built API image.
TW_IMAGE_TAG=local
# Proxy addresses whose X-Forwarded-* headers uvicorn trusts (FORWARDED_ALLOW_IPS).
TW_FORWARDED_ALLOW_IPS=127.0.0.1

# ---------------------------------------------------------------- integration tests (optional)
# Point at the dev stack to run `uv run pytest -m integration`:
# TW_TEST_DATABASE_URL=postgresql+asyncpg://ticketward:<password>@127.0.0.1:5432/ticketward
# TW_TEST_REDIS_URL=redis://127.0.0.1:6379/0
# TW_TEST_REDIS_PASSWORD=<placeholder>
