{
  "openapi": "3.1.0",
  "info": {
    "title": "Ticketward API",
    "version": "0.1.0.dev0"
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe",
        "description": "Report that the process is serving requests.\n\nReturns:\n    ``{\"status\": \"ok\"}``.",
        "operationId": "health_live",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error (RFC 9457 problem details).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error (RFC 9457 problem details).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness probe",
        "description": "Check every backing service required to serve traffic.\n\nArgs:\n    checks: Registered dependency checks.\n    settings: Application settings (per-check timeout).\n\nReturns:\n    ``{\"status\": \"ok\", \"checks\": {...}}`` when all checks pass.\n\nRaises:\n    UpstreamUnavailableError: If any check fails or times out (503).",
        "operationId": "health_ready",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error (RFC 9457 problem details).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error (RFC 9457 problem details).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "503": {
            "description": "One or more dependencies are unavailable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "VALIDATION_ERROR",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "CSRF_FAILED",
          "DEMO_LOCKED",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "REFRESH_SUPERSEDED",
          "IDEMPOTENCY_MISMATCH",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "RATE_LIMITED",
          "UPSTREAM_UNAVAILABLE",
          "MAINTENANCE",
          "INTERNAL"
        ],
        "title": "ErrorCode",
        "description": "Stable machine-readable error codes (spec v1.1 §11)."
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc",
            "description": "Path to the invalid value, e.g. ['body', 'subject']."
          },
          "msg": {
            "type": "string",
            "maxLength": 256,
            "title": "Msg",
            "description": "Human-readable constraint violation."
          },
          "type": {
            "type": "string",
            "maxLength": 64,
            "title": "Type",
            "description": "Pydantic error type, e.g. 'string_too_long'."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "description": "One request-validation failure. The offending input is never echoed back."
      },
      "LiveResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "LiveResponse",
        "description": "Liveness: the process is up and serving requests."
      },
      "ProblemDetail": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Problem type URI."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Short, stable summary of the problem type."
          },
          "status": {
            "type": "integer",
            "maximum": 599.0,
            "minimum": 100.0,
            "title": "Status",
            "description": "HTTP status code."
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Client-safe explanation. Never contains exception text."
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance",
            "description": "Request path (no query string)."
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable machine-readable error code."
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "Correlates with server logs."
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors",
            "description": "Field errors (validation failures only)."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "title": "ProblemDetail",
        "description": "``application/problem+json`` body returned for every error response."
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "checks": {
            "additionalProperties": {
              "type": "string",
              "const": "ok"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "checks"
        ],
        "title": "ReadyResponse",
        "description": "Readiness: every dependency check passed.\n\nFailures are reported as a 503 problem without component detail; the failing\ncomponents are logged server-side with the request id."
      }
    }
  }
}
