yarn-error.log*
frontend/coverage/
frontend/test-results/
frontend/playwright-report/

# ---------------------------------------------------------------- data, models, experiments
# Large datasets are published on the HF Hub; only manifests/specs/KB sources are tracked.
data/raw/
data/generated/
data/cache/
data/exports/
data/**/*.parquet
data/**/*.arrow
data/**/*.feather
# Evaluation run outputs quote dataset tickets (predictions, raw model text); only reports,
# the analysis plan, the sealed-access log and the open gold files are tracked.
evals/runs/
mlruns/
mlartifacts/
wandb/
# Anchored: backend/src/ticketward/db/models/ (ORM code, P4) must stay tracked.
/models/
/checkpoints/
/ml/models/
/ml/checkpoints/
/ml/outputs/
*.gguf
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx

