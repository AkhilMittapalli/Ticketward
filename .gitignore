# ---------------------------------------------------------------- secrets & env
# Real values never enter git; only placeholders are tracked (spec §12.6).
.env
.env.*
!.env.example
secrets/*
!secrets/README.md
!secrets/*.example
*.pem
*.key
*.p12
*.pfx

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
