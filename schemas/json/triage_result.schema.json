{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ChurnRisk": {
      "description": "Churn risk (spec §5.5). Assistive signal only (L-02).",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ChurnRisk",
      "type": "string"
    },
    "EntityType": {
      "description": "Extractable entity types (spec §5.6). PII appears only as masked placeholders.",
      "enum": [
        "error_code",
        "http_status",
        "saml_idp",
        "invoice_id",
        "charge_amount",
        "currency",
        "charge_date",
        "workspace_id",
        "account_id",
        "user_count_affected",
        "browser",
        "os",
        "app_version",
        "integration_name",
        "api_endpoint",
        "feature_name",
        "region",
        "timestamp",
        "competitor_name",
        "legal_reference",
        "steps_already_tried"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "EscalationReason": {
      "description": "Escalation reasons recorded in ``escalation_reasons[]`` (spec §5.9, v1.1).\n\nv1.1 added ``critical_category_suspected`` (rule N6), ``queue_overridden_by_rule``\n(rule N1 / §7.3.2) and ``pii_masking_failed`` (rule P7). They are system-emitted, not\nmodel labels, so ``TAXONOMY_VERSION`` stays ``2026-09-v1`` (ADR-0029 amendment).\nMember order follows the spec list.",
      "enum": [
        "customer_requested_human",
        "forced_category_refund",
        "forced_category_cancellation",
        "forced_category_payment_dispute",
        "forced_category_security",
        "forced_category_legal_threat",
        "forced_category_privacy",
        "active_incident",
        "critical_category_suspected",
        "low_confidence_intent",
        "low_confidence_queue",
        "queue_overridden_by_rule",
        "insufficient_evidence",
        "stale_evidence_only",
        "conflicting_evidence",
        "schema_invalid_after_repair",
        "prompt_injection_suspected",
        "unsupported_language",
        "high_churn_risk_high_value",
        "retention_risk",
        "pii_heavy_content",
        "pii_masking_failed",
        "input_truncated",
        "model_unavailable",
        "agent_initiated"
      ],
      "title": "EscalationReason",
      "type": "string"
    },
    "FieldConfidence": {
      "additionalProperties": false,
      "description": "Calibrated per-field confidence; every field is bounded to ``[0, 1]`` (A-29).",
      "properties": {
        "intent": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Intent",
          "type": "number"
        },
        "priority": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Priority",
          "type": "number"
        },
        "sentiment": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Sentiment",
          "type": "number"
        },
        "churn_risk": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Churn Risk",
          "type": "number"
        },
        "product_area": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Product Area",
          "type": "number"
        },
        "recommended_queue": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Recommended Queue",
          "type": "number"
        },
        "p_critical": {
          "description": "P(any critical intent); feeds rule N6 (§7.3).",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Critical",
          "type": "number"
        }
      },
      "required": [
        "intent",
        "priority",
        "sentiment",
        "churn_risk",
        "product_area",
        "recommended_queue",
        "p_critical"
      ],
      "title": "FieldConfidence",
      "type": "object"
    },
    "Intent": {
      "description": "Primary/secondary customer intent (spec §5.1): 12 intents + reserved fallback.",
      "enum": [
        "sso_login_failure",
        "account_access_issue",
        "billing_duplicate_charge",
        "billing_payment_failure",
        "refund_request",
        "cancellation_request",
        "plan_pricing_inquiry",
        "service_outage",
        "bug_report",
        "how_to_question",
        "security_report",
        "privacy_legal_request",
        "other_unclear"
      ],
      "title": "Intent",
      "type": "string"
    },
    "ModelMeta": {
      "additionalProperties": false,
      "description": "Provenance of a model output (registry version, prompt, calibration, cost).",
      "properties": {
        "provider": {
          "enum": [
            "local_ollama",
            "local_vllm",
            "anthropic",
            "rules_baseline",
            "encoder_baseline"
          ],
          "title": "Provider",
          "type": "string"
        },
        "model_name": {
          "maxLength": 200,
          "title": "Model Name",
          "type": "string"
        },
        "model_version": {
          "description": "Registry version tw-triage-<base>-<method>@<semver>, e.g. \"tw-triage-qwen35-2b-lora@0.1.0\" (illustrative until ADR-0011).",
          "maxLength": 200,
          "title": "Model Version",
          "type": "string"
        },
        "adapter_sha": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Adapter Sha"
        },
        "prompt_version": {
          "maxLength": 64,
          "title": "Prompt Version",
          "type": "string"
        },
        "taxonomy_version": {
          "maxLength": 32,
          "title": "Taxonomy Version",
          "type": "string"
        },
        "schema_version": {
          "default": "triage.v1",
          "maxLength": 32,
          "title": "Schema Version",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 64,
          "title": "Policy Version",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Cost Usd",
          "type": "string"
        },
        "repair_attempts": {
          "minimum": 0,
          "title": "Repair Attempts",
          "type": "integer"
        },
        "confidence_method": {
          "enum": [
            "token_logprob",
            "self_consistency",
            "calibrated_softmax"
          ],
          "title": "Confidence Method",
          "type": "string"
        },
        "calibrator_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "E.g. \"calibrator.v1\" (A-04); null for uncalibrated baselines.",
          "title": "Calibrator Version"
        },
        "calibration_fit_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "eval_runs.id of the val fit.",
          "title": "Calibration Fit Run Id"
        },
        "decoding_backend": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "E.g. \"ollama-0.34.4/llama.cpp-b11081\" or \"vllm-0.30.x/xgrammar\".",
          "title": "Decoding Backend"
        },
        "logprobs_mode": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "E.g. \"ollama-raw-pre-grammar\" or \"vllm-raw_logprobs\".",
          "title": "Logprobs Mode"
        }
      },
      "required": [
        "provider",
        "model_name",
        "model_version",
        "adapter_sha",
        "prompt_version",
        "taxonomy_version",
        "policy_version",
        "latency_ms",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "repair_attempts",
        "confidence_method",
        "calibrator_version",
        "calibration_fit_run_id",
        "decoding_backend",
        "logprobs_mode"
      ],
      "title": "ModelMeta",
      "type": "object"
    },
    "Priority": {
      "description": "Ticket priority (spec §5.3), highest first.",
      "enum": [
        "urgent",
        "high",
        "normal",
        "low"
      ],
      "title": "Priority",
      "type": "string"
    },
    "ProductArea": {
      "description": "Taskmoor product areas (spec §3).",
      "enum": [
        "projects_tasks",
        "boards_timelines",
        "sso_identity",
        "user_admin_permissions",
        "billing_subscriptions",
        "integrations_api",
        "notifications_email",
        "mobile_apps",
        "reporting_analytics",
        "automations",
        "data_import_export",
        "platform_availability"
      ],
      "title": "ProductArea",
      "type": "string"
    },
    "Queue": {
      "description": "Work queues (spec §5.2).",
      "enum": [
        "general_support_tier_1",
        "technical_support_tier_2",
        "billing_and_accounts",
        "customer_success_retention",
        "security_and_privacy",
        "incident_response"
      ],
      "title": "Queue",
      "type": "string"
    },
    "RecommendedAction": {
      "description": "``recommended_action`` vocabulary (spec §5.7).",
      "enum": [
        "answer_with_kb_article",
        "request_more_information",
        "request_saml_error_details_and_check_known_incident",
        "check_known_incident_and_share_status",
        "collect_repro_steps_and_escalate_to_engineering",
        "escalate_to_engineering",
        "escalate_to_billing_for_review",
        "escalate_to_csm_retention",
        "escalate_to_security",
        "escalate_to_privacy_legal",
        "offer_human_contact",
        "send_password_reset_guidance",
        "share_pricing_page_reference",
        "link_to_active_incident",
        "route_to_tier_2",
        "close_as_duplicate_ticket",
        "no_action_spam"
      ],
      "title": "RecommendedAction",
      "type": "string"
    },
    "ResolvedEntity": {
      "additionalProperties": false,
      "description": "Server enrichment of a model entity (``TriageResult`` only, A-29).",
      "properties": {
        "type": {
          "$ref": "#/$defs/EntityType"
        },
        "value": {
          "maxLength": 200,
          "title": "Value",
          "type": "string"
        },
        "source_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact match of value in the masked subject + message; null if absent."
        }
      },
      "required": [
        "type",
        "value",
        "source_span"
      ],
      "title": "ResolvedEntity",
      "type": "object"
    },
    "Sentiment": {
      "description": "Customer sentiment of the latest message (spec §5.4). Assistive signal only (L-02).",
      "enum": [
        "positive",
        "neutral",
        "confused",
        "frustrated",
        "angry"
      ],
      "title": "Sentiment",
      "type": "string"
    },
    "Span": {
      "additionalProperties": false,
      "description": "Half-open character range ``[start, end)`` in masked subject + message coordinates.",
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Span",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "System-enriched triage envelope persisted and returned to the UI.",
  "properties": {
    "intent": {
      "$ref": "#/$defs/Intent"
    },
    "secondary_intents": {
      "description": "No duplicates and never the primary intent; checked after validation (repair level 1 fixes it, §6.6).",
      "items": {
        "$ref": "#/$defs/Intent"
      },
      "maxItems": 2,
      "title": "Secondary Intents",
      "type": "array"
    },
    "priority": {
      "$ref": "#/$defs/Priority"
    },
    "sentiment": {
      "$ref": "#/$defs/Sentiment"
    },
    "churn_risk": {
      "$ref": "#/$defs/ChurnRisk"
    },
    "churn_signals": {
      "items": {
        "maxLength": 200,
        "type": "string"
      },
      "maxItems": 5,
      "title": "Churn Signals",
      "type": "array"
    },
    "product_area": {
      "$ref": "#/$defs/ProductArea"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/ResolvedEntity"
      },
      "maxItems": 20,
      "title": "Entities",
      "type": "array"
    },
    "recommended_queue": {
      "$ref": "#/$defs/Queue"
    },
    "recommended_action": {
      "$ref": "#/$defs/RecommendedAction"
    },
    "customer_requested_human": {
      "title": "Customer Requested Human",
      "type": "boolean"
    },
    "information_sufficient": {
      "title": "Information Sufficient",
      "type": "boolean"
    },
    "rationale": {
      "description": "Short rationale for agent and handoff; not chain-of-thought.",
      "maxLength": 400,
      "title": "Rationale",
      "type": "string"
    },
    "ticket_id": {
      "format": "uuid",
      "title": "Ticket Id",
      "type": "string"
    },
    "triage_run_id": {
      "format": "uuid",
      "title": "Triage Run Id",
      "type": "string"
    },
    "confidence": {
      "$ref": "#/$defs/FieldConfidence"
    },
    "citations": {
      "description": "Cited doc_keys; chunk-level detail lives in DraftResponse.citations (§8.7).",
      "items": {
        "pattern": "^[a-z][a-z0-9_]{1,127}$",
        "type": "string"
      },
      "title": "Citations",
      "type": "array"
    },
    "needs_human_review": {
      "title": "Needs Human Review",
      "type": "boolean"
    },
    "escalation_reasons": {
      "items": {
        "$ref": "#/$defs/EscalationReason"
      },
      "title": "Escalation Reasons",
      "type": "array"
    },
    "policy_decision": {
      "enum": [
        "local_draft",
        "frontier_draft",
        "human_escalation",
        "abstain_request_info"
      ],
      "title": "Policy Decision",
      "type": "string"
    },
    "handoff_summary": {
      "maxLength": 1200,
      "title": "Handoff Summary",
      "type": "string"
    },
    "matched_incident_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Matched Incident Id"
    },
    "model": {
      "$ref": "#/$defs/ModelMeta"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "intent",
    "secondary_intents",
    "priority",
    "sentiment",
    "churn_risk",
    "churn_signals",
    "product_area",
    "entities",
    "recommended_queue",
    "recommended_action",
    "customer_requested_human",
    "information_sufficient",
    "rationale",
    "ticket_id",
    "triage_run_id",
    "confidence",
    "citations",
    "needs_human_review",
    "escalation_reasons",
    "policy_decision",
    "handoff_summary",
    "matched_incident_id",
    "model",
    "created_at"
  ],
  "title": "TriageResult",
  "type": "object"
}
